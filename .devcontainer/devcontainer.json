{
  "name": "ServCheck",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "cp -n .env.example .env && npm install",
  "postAttachCommand": "npm run dev -- --host 0.0.0.0",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "ServCheck (dev server)",
      "onAutoForward": "openBrowser"
    }
  }
}
